{
  "version": 2,
  "name": "titanic-ai-bot",
  "alias": ["titanic-ai-bot.vercel.app"],
  "functions": {
    "api/**/*.js": {
      "runtime": "python3.11",
      "memory": 1024,
      "maxDuration": 60
    },
    "api/**/*.ts": {
      "runtime": "nodejs20.x",
      "memory": 1024,
      "maxDuration": 10
    }
  },
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/next",
      "config": {
        "maxLambdaSize": "30mb",
        "output": "standalone"
      }
    },
    {
      "src": "backend/**/*.py",
      "use": "@vercel/python",
      "config": {
        "pythonVersion": "3.11",
        "installCommand": "pip install -r backend/requirements.txt"
      }
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "env": {
    "KAGGLE_USERNAME": "@kaggle_username",
    "KAGGLE_KEY": "@kaggle_key",
    "MODEL_PATH": "./data/models/titanic_ensemble.pkl",
    "SHAP_BACKGROUND_SIZE": "100",
    "NEXT_PUBLIC_ENABLE_SIMULATION": "true",
    "NEXT_PUBLIC_ENABLE_SHAP": "true",
    "NEXT_PUBLIC_ENABLE_TWIN": "true",
    "NODE_OPTIONS": "--max-old-space-size=4096",
    "PYTHONUNBUFFERED": "1",
    "PYTHONHASHSEED": "42"
  },
  "build": {
    "env": {
      "KAGGLE_USERNAME": "@kaggle_username",
      "KAGGLE_KEY": "@kaggle_key"
    },
    "commands": [
      "pip install -r backend/requirements.txt",
      "npm install",
      "npm run build"
    ],
    "outputDirectory": ".next"
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1",
      "methods": ["GET", "POST", "PUT", "DELETE", "OPTIONS", "PATCH"]
    },
    {
      "src": "/_next/static/(.*)",
      "dest": "/_next/static/$1",
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      }
    },
    {
      "src": "/static/(.*)",
      "dest": "/static/$1",
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      }
    },
    {
      "src": "/",
      "dest": "/"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    }
  ],
  "crons": [
    {
      "path": "/api/train",
      "schedule": "0 0 * * 0"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Credentials", "value": "true" },
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET,OPTIONS,PATCH,DELETE,POST,PUT" },
        { "key": "Access-Control-Allow-Headers", "value": "X-CSRF-Token, X-Requested-With, Accept, Accept-Version, Content-Length, Content-MD5, Content-Type, Date, X-Api-Version, Authorization" },
        { "key": "Access-Control-Max-Age", "value": "86400" }
      ]
    }
  ],
  "regions": ["iad1", "lhr1", "hnd1"],
  "scale": {
    "duration": 60,
    "min": 0,
    "max": 10
  }
}