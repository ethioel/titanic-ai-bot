{
  "name": "titanic-ai-bot",
  "version": "1.0.0",
  "description": "Interactive Titanic Survival AI with SHAP explanations and real-time emergency simulation",
  "author": "Your Name <your.email@example.com>",
  "license": "MIT",
  "private": true,
  "homepage": "https://titanic-ai-bot.vercel.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/titanic-ai-bot"
  },
  "keywords": [
    "titanic",
    "machine-learning",
    "shap",
    "ai",
    "nextjs",
    "vercel"
  ],
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "jest",
    "test:watch": "jest --watch",
    "train": "python backend/train.py",
    "train:prod": "python backend/train.py --prod",
    "deploy": "vercel --prod",
    "deploy:preview": "vercel",
    "docker:build": "docker build -t titanic-ai-bot .",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "clean": "rm -rf .next node_modules",
    "prettier": "prettier --write .",
    "prettier:check": "prettier --check ."
  },
  "dependencies": {
    "next": "14.0.4",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "axios": "^1.6.2",
    "chart.js": "^4.4.1",
    "react-chartjs-2": "^5.2.0",
    "react-markdown": "^9.0.1",
    "remark-gfm": "^4.0.0",
    "framer-motion": "^10.16.16",
    "lucide-react": "^0.294.0",
    "@vercel/analytics": "^1.1.1",
    "zod": "^3.22.4",
    "next-pwa": "^5.6.0",
    "next-themes": "^0.2.1"
  },
  "devDependencies": {
    "@types/node": "^20.10.5",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.18",
    "autoprefixer": "^10.4.16",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.3.6",
    "@tailwindcss/postcss": "latest"
    "typescript": "^5.3.3",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "eslint": "^8.55.0",
    "eslint-config-next": "14.0.4",
    "prettier": "^3.1.1",
    "jest": "^29.7.0",
    "@testing-library/react": "^14.1.2",
    "@testing-library/jest-dom": "^6.1.5"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
